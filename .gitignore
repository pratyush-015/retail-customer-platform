# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ---- Environment / secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- Data cache ----
# The raw dataset (~45 MB) is downloaded at setup time, never committed.
data/raw/
data/processed/
data/*.db
data/*.sqlite
data/*.sqlite3

# Generated audit artifact; a committed sample lives in data/sample/
data/data_quality_report.json

# ---- ML artifacts ----
# Regenerated by `python scripts/train_model.py`
backend/app/ml/artifacts/*.joblib
backend/app/ml/artifacts/*.pkl

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/build/
.vite/
*.local

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/
