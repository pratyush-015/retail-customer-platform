# ============================================================================
# Retail Sales & Customer Insights Platform - environment configuration
# ----------------------------------------------------------------------------
# Copy to `.env` and adjust.  NEVER commit a filled-in `.env`.
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (PowerShell)
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy URL. Every query in the project is written through the SQLAlchemy
# expression layer rather than raw SQL, so the identical pipeline, integrity
# checks and API run on either engine. Both are verified against the full
# ~1M-row dataset and produce identical results.
#
# SQLite is the default so a reviewer can clone and run the whole pipeline with
# no server to install. Postgres is the docker-compose and deployment target.
#
#   Postgres (docker-compose - `db` is the compose service name):
#     DATABASE_URL=postgresql+psycopg2://retail:retail@db:5432/retail_insights
#   Postgres (host machine, container port published):
#     DATABASE_URL=postgresql+psycopg2://retail:retail@localhost:5432/retail_insights
DATABASE_URL=sqlite:///./data/retail_insights.db

# Individual parts, consumed by docker-compose to provision the Postgres
# container. Only used on the Postgres path; keep them in sync with
# DATABASE_URL when you switch to it.
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_DB=retail_insights
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Startup connection retry (exponential backoff) - the API waits for Postgres
# to accept connections instead of crash-looping on `docker-compose up`.
DB_CONNECT_MAX_RETRIES=6
DB_CONNECT_BASE_DELAY=0.5
DB_CONNECT_MAX_DELAY=16.0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Retail Insights Platform
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api

# Comma-separated list of origins allowed to call the API.
# In production set this to your Vercel domain, e.g.
#   CORS_ORIGINS=https://retail-insights.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ---------------------------------------------------------------------------
# Analytics / ML tunables
# ---------------------------------------------------------------------------
# A customer is "churned" if they have not purchased in this many days.
CHURN_THRESHOLD_DAYS=90
# Fraction of customers held out for model evaluation.
MODEL_TEST_SIZE=0.25
# Seed for every stochastic step, so results are reproducible.
RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Paths (relative to repo root; override only if you relocate things)
# ---------------------------------------------------------------------------
DATA_DIR=data
RAW_DATA_DIR=data/raw
MODEL_ARTIFACT_DIR=backend/app/ml/artifacts

# ---------------------------------------------------------------------------
# Frontend (Vite reads only VITE_*-prefixed vars)
# ---------------------------------------------------------------------------
# Local dev points at the FastAPI dev server. On Vercel set this to the
# public backend URL, e.g. https://retail-insights-api.onrender.com/api
VITE_API_URL=http://localhost:8000
